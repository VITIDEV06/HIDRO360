# Referencia: install.sh genera /etc/hidro360/hidro360.env a partir del .env.example de la RAÍZ del repositorio
# (más rutas de /var/lib/hidro360 y tokens aleatorios). Este archivo solo muestra el resultado típico. No versionar el real.
HIDRO360_DB=/var/lib/hidro360/db/hidro360.db
HIDRO360_TRACE=/var/lib/hidro360/logs/trazas.jsonl
HIDRO360_MEDIA_DIR=/var/lib/hidro360/media
# Tokens: los genera install.sh con `openssl rand -hex 32`. Nunca use valores de ejemplo.
HIDRO360_API_TOKEN=CAMBIAR
HIDRO360_DEVICE_TOKEN=CAMBIAR
AI_PROVIDER=auto
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: PostgreSQL/Supabase en lugar de SQLite (pooler de SESION, puerto 5432; sin DATABASE_URL se usa SQLite).
# DATABASE_URL, HIDRO360_STORAGE, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY: ver .env.example de la raiz y docs/DESPLIEGUE.md.
