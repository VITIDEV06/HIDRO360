[Unit]
Description=HIDRO360 - copia de seguridad (SQLite + fotos + trazas)
Documentation=file:///opt/hidro360/docs/INSTALACION.md

[Service]
Type=oneshot
User=hidro360
Group=hidro360
WorkingDirectory=/opt/hidro360
EnvironmentFile=/etc/hidro360/hidro360.env
Environment=HOME=/var/lib/hidro360 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/hidro360/deploy/raspberry/backup.sh
SyslogIdentifier=hidro360-backup
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hidro360
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
