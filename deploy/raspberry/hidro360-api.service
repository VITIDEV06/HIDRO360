[Unit]
Description=HIDRO360 - API FastAPI (uvicorn)
Documentation=file:///opt/hidro360/docs/INSTALACION.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=hidro360
Group=hidro360
WorkingDirectory=/opt/hidro360
EnvironmentFile=/etc/hidro360/hidro360.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/var/lib/hidro360
# Escucha en toda la red LOCAL (la Raspberry atiende a otros equipos y a las terminales). NO exponer a Internet.
ExecStart=/opt/hidro360/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
# Salida a journald: journalctl -u hidro360-api -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hidro360-api

# Endurecimiento: solo escribe en /var/lib/hidro360
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hidro360
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
