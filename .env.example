# =====================================================================================================
# HIDRO360 - configuracion de ejemplo. La demo local NO requiere nada de esto (SQLite + modo local).
# Copie a .env (esta en .gitignore) y descomente solo lo que necesite:   scripts\dev.ps1  lo hace por usted.
#
# REGLAS
#  - config.py lee .env al iniciar SIN pisar variables ya definidas en el entorno (el entorno gana).
#  - Formato estricto: NOMBRE=valor, un valor por linea, SIN comentarios al final de la linea
#    (el cargador no los quita: "X=1 # nota" guardaria "1 # nota").
#  - Las pruebas (pytest) y HIDRO360_ENV=test NO leen .env: nunca tocan una base ni claves reales.
#  - Precedencia de nombres: HIDRO360_* gana a AGUA_CLARA_* (alias OBSOLETO, solo compatibilidad).
#  - Marca [SECRETO]: nunca en el repositorio, ni en el navegador/cliente, ni en el firmware, ni en capturas o
#    logs. Solo en el entorno del servidor (.env local, /etc/hidro360/hidro360.env, variables de Vercel).
#  - En la Raspberry este archivo es la plantilla de /etc/hidro360/hidro360.env (lo crea install.sh).
#  - Todos los valores de ejemplo de abajo son FALSOS.
# =====================================================================================================

# ---------- Perfil -----------------------------------------------------------------------------------
# dev (defecto) | test | prod. En "test" no se lee .env.
# HIDRO360_ENV=dev

# ---------- IA (Gemini, opcional) --------------------------------------------------------------------
# auto = Gemini solo si hay GEMINI_API_KEY (defecto) | local = reglas, nada sale | gemini = fuerza Gemini
AI_PROVIDER=auto
# [SECRETO] https://aistudio.google.com/apikey  Vacia/comentada => modo local.
# GEMINI_API_KEY=
# Modelo (verifique con: python -m scripts.verificar_gemini)
# GEMINI_MODEL=gemini-3.5-flash-lite
# Tiempo por llamada y reintentos. En Vercel: 2 etapas x (timeout x (1+reintentos)) debe caber en maxDuration.
# AI_TIMEOUT_SECONDS=15
# AI_MAX_REINTENTOS=1

# ---------- Tokens de la API -------------------------------------------------------------------------
# [SECRETO] Token de servicio (administracion desde otros sistemas).
#   Generar: python -c "import secrets; print(secrets.token_hex(32))"
# HIDRO360_API_TOKEN=reemplazar-por-64-hex-aleatorios
# [SECRETO] Token de dispositivo HEREDADO (pantalla de monitoreo). Las cisternas usan un token propio por
# vehiculo: python -m scripts.registrar_dispositivo CIS-01
# HIDRO360_DEVICE_TOKEN=reemplazar-por-otro-valor-aleatorio

# ---------- Almacenamiento local (perfil dev / Raspberry) ---------------------------------------------
# Base SQLite (se ignora si DATABASE_URL esta definida). Defecto: agua_clara.db en la raiz.
# HIDRO360_DB=agua_clara.db
# Fotografias (HIDRO360_STORAGE=local). Defecto: media/. Limites (3 fotos, 3 MB) son constantes de config.py.
# HIDRO360_MEDIA_DIR=media
# Trazas JSONL. Ruta de archivo, o la palabra stdout (obligatorio en Vercel: el disco es de solo lectura).
# HIDRO360_TRACE=logs/trazas.jsonl

# ---------- PostgreSQL / Supabase (perfil nube) -------------------------------------------------------
# [SECRETO] Si esta definida, se usa PostgreSQL en lugar de SQLite. Lleva la contrasena de la base.
#   Funcion serverless (Vercel): pooler en modo TRANSACCION, puerto 6543, usuario postgres.<ref-proyecto>.
#   Proceso persistente (UI en Windows/Raspberry, migraciones): pooler en modo sesion 5432 o conexion directa.
# DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:6543/postgres
# local = cuentas propias en la base | supabase = JWT de Supabase Auth verificado en el backend
# HIDRO360_AUTH=local
# local = carpeta HIDRO360_MEDIA_DIR | supabase = bucket PRIVADO (acceso solo desde el backend)
# HIDRO360_STORAGE=local
# URL del proyecto (no secreta, pero propia de su proyecto).
# SUPABASE_URL=https://PROYECTO.supabase.co
# Clave publica por diseno (RLS la limita). Es la UNICA de Supabase que podria ir a un navegador.
# SUPABASE_ANON_KEY=
# [SECRETO] Clave privilegiada: omite RLS. SOLO en el servidor. Nunca en navegador, firmware ni repositorio.
# SUPABASE_SERVICE_ROLE_KEY=
# [SECRETO] Solo si el proyecto firma los JWT con secreto simetrico (HS256).
# SUPABASE_JWT_SECRET=
# Nombre del bucket de fotos (privado).
# SUPABASE_STORAGE_BUCKET=reportes-fotos
# Nombre del bucket de notas de voz / audios (privado, distinto del de fotos).
# SUPABASE_AUDIO_BUCKET=reportes-audios
# Origenes permitidos por CORS, separados por comas. Vacio = sin CORS (defecto, recomendado).
# HIDRO360_CORS_ORIGINS=https://su-dominio.example

# ---------- Telegram (canal de entrada de reportes) -------------------------------------------------
# Sin estas variables el webhook responde 503 y no se procesa NADA. El bot lo crea y lo registra quien despliegue.
# [SECRETO] Token que da @BotFather. SOLO en el servidor (.env local o variables de Vercel), nunca en repositorio
# ni en el navegador ni en el firmware. Nunca haga commit de un valor real.
# TELEGRAM_BOT_TOKEN=
# [SECRETO] Secreto del webhook: Telegram lo reenvia en la cabecera X-Telegram-Bot-Api-Secret-Token y el backend lo
# exige. Generelo aleatoriamente (min. 32 caracteres), p. ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# TELEGRAM_WEBHOOK_SECRET=
# Ruta del webhook (configurable). Debe coincidir con la que se registre en setWebhook (ver docs/DESPLIEGUE.md).
# TELEGRAM_WEBHOOK_PATH=/api/v1/telegram/webhook
# Para registrar el webhook desde el terminal (tras tener la URL publica):
#   python -m scripts.telegram_webhook configurar --url https://SU-DOMINIO.com/api/v1/telegram/webhook
# Transcriptor de notas de voz: simulada (defecto, sin red, NO transcribe y lo declara). Proveedor real = adaptador propio.
# HIDRO360_TRANSCRIPCION=simulada
# URL publica de la app (para enlaces en mensajes; no es secreta). Vacio en local.
# PUBLIC_APP_URL=
# Limites del canal (defectos: 20 mensajes cada 60 s por chat).
# HIDRO360_TELEGRAM_MAX_MENSAJES=20
# HIDRO360_TELEGRAM_VENTANA_S=60
# Tope por nota de voz descargada (defecto 10 MiB).
# HIDRO360_MAX_BYTES_AUDIO=10485760
# Base de la API de Telegram SOLO para pruebas (no cambiar en producción).
# TELEGRAM_API_BASE=https://api.telegram.org

# ---------- Perfiles tipicos -------------------------------------------------------------------------
# DESARROLLO LOCAL : nada (SQLite + local) o solo GEMINI_API_KEY.
# PRUEBAS          : HIDRO360_ENV=test (pytest ya lo aisla; no lea .env).
# PRODUCCION VERCEL: HIDRO360_ENV=prod, DATABASE_URL (pooler 6543), HIDRO360_AUTH=supabase o local,
#                    HIDRO360_STORAGE=supabase, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, HIDRO360_TRACE=stdout,
#                    HIDRO360_API_TOKEN, GEMINI_API_KEY (opcional) y, para Telegram, TELEGRAM_BOT_TOKEN +
#                    TELEGRAM_WEBHOOK_SECRET. Se cargan en el panel de Vercel, NO en un archivo.
# UI FLET (Windows/Raspberry) contra Supabase: DATABASE_URL (pooler sesion 5432), HIDRO360_STORAGE y
#                    SUPABASE_* como arriba, en .env local o /etc/hidro360/hidro360.env.
# Lista completa y reparto por entorno: docs/DESPLIEGUE.md

# ---------- Nombres antiguos (OBSOLETOS; siguen funcionando) -------------------------------------------
# AGUA_CLARA_DB, AGUA_CLARA_TRACE, AGUA_CLARA_MEDIA_DIR, AGUA_CLARA_API_TOKEN, AGUA_CLARA_DEVICE_TOKEN.
# Si existen ambos nombres, gana HIDRO360_*. No los use en instalaciones nuevas.

# --- Demostración local ----------------------------------------------------------------
# HIDRO360_BD=sqlite        # fuerza SQLite aunque DATABASE_URL exista (scripts\demo_local.ps1 lo fija)
# TELEGRAM_BOT_TOKEN=       # token de BotFather para scripts.bot_telegram (nunca subir el valor real)
